# ── Credentials — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.toml
.streamlit/secrets.toml
credentials.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Testing and coverage ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Generated data ───────────────────────────────────────────────────────────
# Model artifacts in dashboard/models/ ARE tracked intentionally: the prototype
# ships with them so it runs on a fresh clone without a training step.
data/raw/
data/interim/
data/processed/
*.parquet
!dashboard/models/*.joblib

# These two processed tables are cited by name in FINAL_REVIEW.md and
# IBM-SUBMISSION-CANDIDATE.json, so they must resolve in a fresh clone.
# Tracked deliberately (83 KB combined); the blanket *.parquet rule above
# still excludes everything else.
!dashboard/data/processed/daily_master.parquet
!dashboard/data/processed/features_v1.parquet

# ── Runtime logs ─────────────────────────────────────────────────────────────
*.log
streamlit_stdout.log

# ── OS and editor ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# pytest scratch dirs (contain generated model binaries)
.pytest_basetemp*/
.aevion_check.py

# pytest scratch dirs (generated .joblib artifacts must never be committed).
#
# Match on the .pytest_ prefix rather than on individual basetemp names. Naming
# each one has now failed three times: .pytest_basetemp*, then .pytest_temp*,
# then .pytest_run_final2/ and .pytest_run_final3/, which slipped past both
# rules and which `git add -A --dry-run` confirmed would stage dozens of
# generated .joblib files into a public repository. Any --basetemp a future run
# chooses is covered by the prefix; no new rule is needed per name.
.pytest_*/

# Submission vet package is filled locally and handed off as a ZIP.
# Do not commit the working package into the freeze tree.
AEVION_FULL_GREEN_VET_PACKAGE_v0.1/
AEVION_FULL_GREEN_VET_PACKAGE_READY.zip
